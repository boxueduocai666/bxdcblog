<dialog class="search-dialog" id="site-search" aria-labelledby="search-title">
  <div class="search-dialog__inner">
    <div class="search-dialog__top">
      <h2 id="search-title">搜索文章</h2>
      <button class="icon-button" type="button" data-search-close aria-label="关闭搜索">Esc</button>
    </div>
    <label class="search-field">
      <span class="sr-only">输入关键词</span>
      <input id="site-search-input" type="search" placeholder="搜索标题、摘要、分类或标签…" autocomplete="off" />
      <kbd>↵</kbd>
    </label>
    <p class="search-hint" id="search-hint">输入关键词开始搜索。</p>
    <ul class="search-results" id="search-results" aria-live="polite"></ul>
  </div>
</dialog>
