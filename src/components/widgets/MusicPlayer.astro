<div class="music-widget" data-music-widget>
  <audio data-music-audio preload="none"></audio>
  <button class="music-toggle" type="button" data-music-toggle aria-label="打开音乐播放器">♫</button>
  <div class="music-popover glass-surface" data-music-panel hidden>
    <div><span class="music-eyebrow">AMBIENT / PLAYER</span><strong data-music-title>尚未播放</strong><small data-music-artist>添加本地音乐后即可使用</small></div>
    <div class="music-controls">
      <button type="button" data-music-prev aria-label="上一首">‹</button>
      <button type="button" data-music-play aria-label="播放或暂停">▶</button>
      <button type="button" data-music-next aria-label="下一首">›</button>
    </div>
    <span class="music-status" data-music-status>播放器默认关闭</span>
  </div>
</div>
