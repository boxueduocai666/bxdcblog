---
import type { BlogPost } from '../../lib/content';
import { taxonomyUrl, withBase } from '../../lib/urls';
import PostMeta from './PostMeta.astro';
interface Props { post: BlogPost; compact?: boolean; }
const { post, compact = false } = Astro.props;
const href = withBase(`/posts/${post.id}/`);
---
<article class:list={['post-card', { 'post-card--compact': compact, 'post-card--pinned': post.data.pinned }]}>
  {post.data.pinned && <span class="post-kicker">置顶文章</span>}
  <h3 class="post-card__title"><a href={href}>{post.data.title}</a></h3>
  <PostMeta post={post} />
  {post.data.excerpt && <p class="post-card__excerpt">{post.data.excerpt}</p>}
  <div class="post-card__bottom">
    <div class="tag-list">
      {post.data.tags.slice(0, 4).map((tag) => <a class="tag-chip" href={taxonomyUrl('tags', tag)}>{tag}</a>)}
    </div>
    <a class="read-link" href={href} aria-label={`阅读：${post.data.title}`}>阅读全文 <span aria-hidden="true">↗</span></a>
  </div>
</article>
