---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/posts/PostMeta.astro';
import ArticleToc from '../../components/reader/ArticleToc.astro';
import ArticleToolbar from '../../components/reader/ArticleToolbar.astro';
import TwikooComments from '../../components/comments/TwikooComments.astro';
import { withBase, taxonomyUrl } from '../../lib/urls';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const description = post.data.excerpt || `${post.data.title} · boxueduocai`;
---
<BaseLayout title={`${post.data.title} · boxueduocai`} description={description} article>
  <article class="article-layout" id="article-top">
    <div class="article-main glass-surface">
      <a class="back-link" href={withBase('/')}>← 返回首页</a>
      <header class="article-header">
        <div class="article-kicker"><span>{post.data.category}</span><span>·</span><span>JOURNAL ENTRY</span></div>
        <h1>{post.data.title}</h1>
        <PostMeta post={post} />
        {post.data.excerpt && <p class="article-excerpt">{post.data.excerpt}</p>}
        {post.data.tags.length > 0 && <div class="tag-list article-tags">{post.data.tags.map((tag) => <a class="tag-chip" href={taxonomyUrl('tags', tag)}>{tag}</a>)}</div>}
      </header>
      <div class="article-content prose"><Content /></div>
      <div class="article-end"><span>—</span><p>感谢阅读，愿你今天也有一点收获。</p></div>
      <ArticleToolbar />
      <TwikooComments />
    </div>
    <aside class="article-side"><ArticleToc headings={headings} /></aside>
  </article>
</BaseLayout>
