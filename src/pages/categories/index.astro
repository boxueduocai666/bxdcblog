---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getCategories } from '../../lib/content';
import { withBase } from '../../lib/urls';
const posts = await getPublishedPosts();
const categories = getCategories(posts);
---
<BaseLayout title="文章分类 · boxueduocai">
  <section class="subpage-heading"><span>TOPICS</span><h1>文章分类</h1><p>按主题整理的记录。</p></section>
  <div class="taxonomy-grid">{categories.map((category) => <a class="taxonomy-card glass-surface" href={withBase(`/categories/${encodeURIComponent(category.slug)}/`)}><span>COLLECTION</span><h2>{category.name}</h2><p>{category.count} 篇文章</p><b>↗</b></a>)}</div>
</BaseLayout>
